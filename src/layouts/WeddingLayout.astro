---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  view: 'public' | 'extended' | 'develop';
  title?: string;
}

const { view, title = `${siteConfig.couple} · Wedding Invitation` } = Astro.props;
const description = `Join ${siteConfig.couple} in ${siteConfig.location} on ${siteConfig.dates}.`;
const assetBase = `${import.meta.env.BASE_URL}/assets/themes`.replace(/\/+/g, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body
    data-view={view}
    data-theme={siteConfig.theme}
    style={`--hero-art-festive: url('${assetBase}/contemporary-festive.webp'); --hero-art-earthy: url('${assetBase}/earthy-handcrafted.webp'); --hero-art-editorial: url('${assetBase}/modern-editorial.webp'); --hero-art-pastel: url('${assetBase}/pastel-garden.webp');`}
  >
    <main>
      <slot />
    </main>
  </body>
</html>
