---
import { siteConfig } from '../config/site';

interface Props {
  includeUpdates?: boolean;
}

const { includeUpdates = true } = Astro.props;
---

<section class="section-shell info-grid" aria-label="Wedding information">
  <article class="info-card">
    <p class="eyebrow">The venue</p>
    <h2>{siteConfig.venue.name}</h2>
    <p>{siteConfig.venue.address}</p>
    <p class="muted">{siteConfig.venue.note}</p>
    <a class="text-link" href={siteConfig.venue.mapUrl}>Open map →</a>
  </article>
  <article class="info-card">
    <p class="eyebrow">Stay</p>
    <h2>{siteConfig.accommodation.title}</h2>
    <p>{siteConfig.accommodation.body}</p>
  </article>
</section>

{includeUpdates && <slot name="updates" />}
