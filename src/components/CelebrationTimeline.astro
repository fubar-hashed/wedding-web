---
const assetBase = `${import.meta.env.BASE_URL}/assets/invitations`.replace(/\/+/g, '/');
---

<section class="celebration-section section-shell" id="celebrations" aria-labelledby="celebrations-title">
  <div class="section-heading">
    <p class="eyebrow">Three days, one story</p>
    <h2 id="celebrations-title">The celebrations</h2>
  </div>

  <section class="save-date save-date-solo" aria-labelledby="save-date-title">
    <div class="save-date-copy">
      <p class="eyebrow">A little something to uncover</p>
      <h3 id="save-date-title">Save the date</h3>
      <p>Scratch the card to reveal the day we say “I do.”</p>
      <div class="scratch-card" data-scratch-card>
        <div class="scratch-date" aria-live="polite">
          <span>Save the date</span>
          <time datetime="2027-01-27">27 January 2027</time>
        </div>
        <canvas class="scratch-cover" data-scratch-cover aria-hidden="true"></canvas>
      </div>
      <button class="scratch-reveal button button-primary" data-scratch-reveal type="button">Reveal the date</button>
      <p class="scratch-hint" data-scratch-hint>Use your finger or mouse to scratch the card.</p>
    </div>
  </section>

  <ol class="celebration-timeline" aria-label="Wedding celebration timeline">
    <li class="timeline-entry timeline-engagement" id="sangeet-engagement">
      <span class="timeline-marker" aria-hidden="true">01</span>
      <article class="timeline-card">
        <div class="timeline-copy">
          <p class="eyebrow">26 January 2027 · Evening</p>
          <h3>Engagement</h3>
          <p>Join us for an evening of music, laughter, and family as we celebrate our engagement and the beginning of this beautiful chapter together.</p>
          <p class="event-detail"><span>Attire</span>Festive attire</p>
        </div>
        <figure class="timeline-image-frame timeline-media">
          <img
            class="timeline-image"
            src={`${assetBase}/engagement-save-the-date.png`}
            alt="Illustrated engagement announcement for 26 January 2027"
            loading="lazy"
          />
        </figure>
      </article>
    </li>
    <li class="timeline-entry timeline-haldi" id="haldi">
      <span class="timeline-marker" aria-hidden="true">02</span>
      <article class="timeline-card">
        <figure class="timeline-video timeline-media">
          <video controls playsinline muted preload="metadata" aria-label="Haldi invitation video">
            <source src={`${assetBase}/traditional-wedding-invitation.mp4`} type="video/mp4" />
            Your browser does not support video playback.
          </video>
          <figcaption>Haldi invitation</figcaption>
        </figure>
        <div class="timeline-copy timeline-copy-haldi">
          <div class="haldi-art" aria-hidden="true"><span>✿</span><span>✿</span><span>✿</span></div>
          <p class="eyebrow">27 January 2027 · Afternoon</p>
          <h3>Haldi</h3>
          <p>Spend a bright, joyful afternoon with us and the people closest to us, sharing the color, warmth, and blessings of the Haldi before the wedding.</p>
          <p class="event-detail"><span>Attire</span>Comfortable festive attire</p>
        </div>
      </article>
    </li>
    <li class="timeline-entry timeline-wedding" id="baraat-reception">
      <span class="timeline-marker" aria-hidden="true">03</span>
      <article class="timeline-card">
        <div class="timeline-copy">
          <p class="eyebrow">27 January 2027 · Evening</p>
          <h3>Wedding</h3>
          <p>Join the baraat and stay for the reception as our families come together for an evening of celebration. We look forward to sharing the start of married life with you.</p>
          <p class="event-detail"><span>Attire</span>Festive formal</p>
        </div>
        <figure class="timeline-video timeline-media">
          <video controls playsinline muted preload="metadata" aria-label="Wedding announcement reel">
            <source src={`${assetBase}/wedding-announcement-reel.mp4`} type="video/mp4" />
            Your browser does not support video playback.
          </video>
          <figcaption>Wedding announcement</figcaption>
        </figure>
      </article>
    </li>
  </ol>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-scratch-card]');

  cards.forEach((card) => {
    const canvas = card.querySelector<HTMLCanvasElement>('[data-scratch-cover]');
    const revealButton = card.parentElement?.querySelector<HTMLButtonElement>('[data-scratch-reveal]');
    const hint = card.parentElement?.querySelector<HTMLElement>('[data-scratch-hint]');
    const context = canvas?.getContext('2d', { willReadFrequently: true });
    if (!canvas || !context || !revealButton) return;

    const brush = context;
    let scratching = false;
    let completed = false;

    const resizeCover = () => {
      const bounds = card.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(bounds.width * ratio);
      canvas.height = Math.round(bounds.height * ratio);
      brush.setTransform(ratio, 0, 0, ratio, 0, 0);
      const gradient = brush.createLinearGradient(0, 0, bounds.width, bounds.height);
      gradient.addColorStop(0, '#f5d9a9');
      gradient.addColorStop(0.5, '#e8bc78');
      gradient.addColorStop(1, '#f2d19a');
      brush.globalCompositeOperation = 'source-over';
      brush.fillStyle = gradient;
      brush.fillRect(0, 0, bounds.width, bounds.height);
      brush.fillStyle = 'rgba(125, 61, 35, 0.78)';
      brush.font = '600 13px Manrope, sans-serif';
      brush.textAlign = 'center';
      brush.textBaseline = 'middle';
      brush.fillText('✧  SCRATCH TO REVEAL  ✧', bounds.width / 2, bounds.height / 2);
      brush.globalCompositeOperation = 'destination-out';
    };

    const reveal = () => {
      completed = true;
      card.classList.add('is-revealed');
      hint?.setAttribute('hidden', '');
    };

    const eraseAt = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();
      brush.beginPath();
      brush.arc(event.clientX - bounds.left, event.clientY - bounds.top, 24, 0, Math.PI * 2);
      brush.fill();
    };

    const checkProgress = () => {
      const pixels = brush.getImageData(0, 0, canvas.width, canvas.height).data;
      let clearPixels = 0;
      const stride = 4 * 16;
      for (let index = 3; index < pixels.length; index += stride) {
        if (pixels[index] < 32) clearPixels++;
      }
      if (clearPixels / (pixels.length / stride) > 0.38) reveal();
    };

    canvas.addEventListener('pointerdown', (event) => {
      if (completed) return;
      scratching = true;
      canvas.setPointerCapture(event.pointerId);
      eraseAt(event);
    });
    canvas.addEventListener('pointermove', (event) => {
      if (!scratching || completed) return;
      eraseAt(event);
    });
    canvas.addEventListener('pointerup', () => {
      if (!scratching || completed) return;
      scratching = false;
      checkProgress();
    });
    canvas.addEventListener('pointercancel', () => { scratching = false; });
    revealButton.addEventListener('click', reveal);
    resizeCover();
    new ResizeObserver(resizeCover).observe(card);
  });

  const timelineVideos = document.querySelectorAll<HTMLVideoElement>('.celebration-timeline video');
  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { threshold: [0, 0.5] });

    timelineVideos.forEach((video) => videoObserver.observe(video));
  }
</script>
